          "id": "acd59f89-b84d-44cd-a7b9-ed7678237383",
          "name": "Login",
          "request": {
            "name": "Login",
            "description": {
              "content": "Login returns three different tokens: `token` (auth, 1 hour), `accessToken` (MFA / logout, 1 hour), and `refreshToken` (30 days). If your account has active MFA, first call returns `session` which is used in a second call along with the MFA code.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"<email>\",\n  \"password\": \"<string>\",\n  \"session\": \"<string>\",\n  \"code\": \"<string>\",\n  \"challenge\": \"SMS_MFA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
