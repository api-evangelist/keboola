{
  "opencollection": "1.0.0",
  "info": {
    "name": "AI Service Actions Admin Users API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Admin Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/users",
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List all user accounts. Requires an admin token."
        },
        {
          "info": {
            "name": "Delete user",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin/users/:username",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a user account. Requires an admin token."
        },
        {
          "info": {
            "name": "Disable user MFA",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin/users/:username/mfa",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Disable MFA for a user account. Requires an admin token."
        },
        {
          "info": {
            "name": "Add user to a vendor",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/admin/users/:username/vendors/:vendor",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "path"
              },
              {
                "name": "vendor",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Add a user to a vendor. Sends email confirmation to the user. Requires an admin token."
        },
        {
          "info": {
            "name": "Remove user from a vendor",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin/users/:username/vendors/:vendor",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "path"
              },
              {
                "name": "vendor",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove a user from a vendor. Sends email confirmation to the user. Requires an admin token."
        },
        {
          "info": {
            "name": "Make user admin",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/admin/users/:username/admin",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Grant admin privileges to a user. Requires an admin token."
        },
        {
          "info": {
            "name": "Remove admin privilege",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin/users/:username/admin",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Revoke admin privileges from a user. Requires an admin token."
        }
      ]
    }
  ],
  "bundled": true
}