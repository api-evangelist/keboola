                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"event\": \"job-failed\",\n  \"filters\": [\n    {\n      \"field\": \"job.component.id\",\n      \"value\": \"my.component\"\n    },\n    {\n      \"field\": \"job.configuration.id\",\n      \"value\": \"12345\"\n    }\n  ],\n  \"recipient\": {\n    \"channel\": \"email\",\n    \"address\": \"user@example.com\"\n  }\n}",
                  "options": {
