        {
          "id": "9ffc5a26-910d-4f82-bd5b-f55a4bed59fb",
          "name": "Create a new project-level notification subscription",
          "request": {
            "name": "Create a new project-level notification subscription",
            "description": {
              "content": "Subscribe a recipient for notifictions on given event type.\n\nBy default, a notification is sent to all occurences of the event. You can set `filters` which are then matched\nagainst event data to subscribe to more specific situations.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "project-subscriptions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"<string>\",\n  \"projectId\": \"<string>\",\n  \"recipient\": {\n    \"channel\": \"<string>\",\n    \"address\": \"<email>\"\n  },\n  \"expiresAt\": \"<string>\",\n  \"filters\": [\n    {\n      \"field\": \"<string>\",\n      \"value\": \"<string>\"\n    },\n    {\n      \"field\": \"<string>\",\n      \"value\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "92522cf4-d861-4f08-bdb2-d8fd6f9ca21a",
              "name": "Subscription created",
              "originalRequest": {
